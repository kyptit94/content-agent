# Local LLM (Ollama)
LOCAL_LLM_MODEL=qwen2.5:3b

# Web console auth (required)
WEB_ADMIN_TOKEN=change-me
INGEST_DIR=/app/data/uploads

# Gemini Free API
# Used for pre-moderation and optional refine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_PRECHECK_MODE=risky
GEMINI_PRECHECK_CACHE_TTL_SEC=86400
GEMINI_REFINE_CACHE_TTL_SEC=604800

# Optional Telegram notifications for done/error from web jobs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DELETE_OUTPUT_AFTER_TELEGRAM=false
FEEDBACK_MAX_ROUNDS=1
FEEDBACK_NOTE_MAX_CHARS=180
AUTO_TOPIC_INTERVAL_MINUTES=15
AUTO_TOPIC_DEFAULT_MODE=sales

# Social auto publish
AUTO_PUBLISH_ENABLED=false
AUTO_PUBLISH_PLATFORMS=youtube
SOCIAL_WEBHOOK_URL=

# YouTube OAuth (refresh token flow)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=private

# Facebook Page publish
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Internal settings
REDIS_URL=redis://redis:6379/0
JOB_QUEUE_NAME=content_jobs
OLLAMA_BASE_URL=http://ollama:11434
VOICE_API_URL=http://voice:8010

# Licensed stock video providers (optional but required for auto internet fetch)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# portrait or landscape
VIDEO_SIZE=portrait
STOCK_VIDEO_CACHE_TTL_SEC=604800
VIDEO_PRESERVE_QUALITY=true
VIDEO_TEXT_OVERLAY=false
VIDEO_REENCODE_CRF=18
VIDEO_REENCODE_PRESET=medium
